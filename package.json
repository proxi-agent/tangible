{
  "name": "tangible",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "ingest": "pnpm --filter @tangible/api ingest",
    "seed": "pnpm --filter @tangible/api seed",
    "export:parquet": "pnpm --filter @tangible/api export:parquet",
    "publish:parquet": "pnpm --filter @tangible/api publish:parquet",
    "db:generate": "pnpm --filter @tangible/db db:generate",
    "db:push": "pnpm --filter @tangible/db db:push"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
