# ---------------------------------------------------------------------------
# Analytics warehouse (DuckDB) — local file, holds the full public-record roll
# ---------------------------------------------------------------------------
DUCKDB_PATH=./data/tangible.duckdb
# Where downloaded/extracted county source files land before they are loaded.
DATA_DIR=./data/raw

# ---------------------------------------------------------------------------
# Supabase Postgres — application state (ingest runs, clients, engagements, the
# assets a fixed asset register normalizes into).
# Create a project at https://supabase.com/dashboard, then copy these values.
# ---------------------------------------------------------------------------
# Settings -> Database -> Connection string -> URI (use the pooled 6543 port for
# the app, the direct 5432 port for `db:push` migrations). The market pages run
# without this; the workspace needs it.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Storage for uploaded registers. Left unset, uploads land in ./data/uploads —
# fine locally, not fine in a deployment. These are placeholders on purpose:
# filled with a real project's values, uploads go to a private bucket there.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Published warehouse (deployment only)
# ---------------------------------------------------------------------------
# A serverless filesystem is read-only and cannot hold a 500 MB DuckDB file, so
# a deployment reads the Parquet export instead. `pnpm export:parquet` writes
# it; `pnpm publish:parquet` uploads it and prints the value for this. Set here,
# it takes precedence over DUCKDB_PATH — leave it unset locally to read the
# warehouse file.
# PARQUET_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Cloudflare R2 — the recommended home for the export. Every cold instance
# pulls the whole ~95 MB copy, and R2 does not charge for egress. Create the
# bucket at dash.cloudflare.com -> R2, enable public access, then make an API
# token with Object Read & Write.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=tangible-warehouse
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# The export is copied to local disk on first use and queried from there —
# roughly 2x faster than reading over HTTP, because a page load makes thousands
# of range requests and each one would pay the round trip. On by default when
# PARQUET_BASE_URL is remote. Any failure falls back to reading over HTTP.
# PARQUET_CACHE=off              # disable the copy entirely
# PARQUET_CACHE_DIR=             # defaults to <tmp>/tangible-parquet
# PARQUET_CACHE_MAX_MB=400       # refuse to cache an export larger than this

# DuckDB's memory limit is a hard ceiling, not a hint: keep it below the memory
# configured for the function or queries fail rather than spill.
# DUCKDB_MEMORY_LIMIT=1GB
# DUCKDB_THREADS=2
# Where httpfs may be written. Defaults to the system temp directory, which is
# the only writable path on most serverless hosts. Point this at a directory
# holding a pre-installed extension to skip the download on every cold start.
# DUCKDB_EXTENSION_DIR=

# ---------------------------------------------------------------------------
# Ingest server (NestJS)
# ---------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Where the web app forwards /api/ingest/*. Defaults to localhost:3001 in
# development and to nothing in production, where ingest cannot run at all.
# INGEST_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Workspace (clients, FAR intake) — the taxpayer side of the product
# ---------------------------------------------------------------------------
# AI mapping proposals and asset classification need one model provider. Set
# either key; without one, both screens still work — columns are mapped by hand
# and classifications go to the review queue instead of being pre-filled.
#
# When both are set, Anthropic is used: the prompts were written against Claude,
# so it is the known quantity. Set AI_PROVIDER to force one either way.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# anthropic | openai. Leave unset to pick automatically from the keys present.
# AI_PROVIDER=
#
# Two calls, two economics. Classification runs once per distinct asset
# description and is what scales with register size, so it defaults to the
# cheapest tier (gpt-5.4-nano / claude-haiku-4-5) — safe because the confidence
# bar sends anything the model is unsure about to a human rather than applying
# it. Mapping runs once per uploaded file and is the one place a mistake is
# unrecoverable, so it defaults to the strong model (gpt-5.5 / claude-opus-5).
# ANTHROPIC_MODEL=
# ANTHROPIC_MAPPING_MODEL=
# OPENAI_MODEL=
# OPENAI_MAPPING_MODEL=

# Comma-separated emails allowed to sign in. The gate fails closed: with auth
# configured and this unset, nobody is admitted. That is deliberate — the anon
# key below ships to the browser and Supabase projects allow signup by default,
# so "any authenticated account" would mean any account on the internet.
# AUTH_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# The dashboard serves its own API from Next route handlers, so this is empty by
# default and requests are same-origin. Set it only to point the UI at a
# warehouse hosted somewhere else.
# NEXT_PUBLIC_API_URL=

# Setting both of these turns on the sign-in gate for the whole app; leaving
# them unset runs it open, which is the local development mode. Commented out
# rather than left as placeholders, because placeholder values switch the gate
# on and point it at a host that does not exist. Set them together with
# AUTH_ALLOWED_EMAILS before any client data goes in.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Transactional email (deployment only)
# ---------------------------------------------------------------------------
# The portal is asynchronous from the client's side: they send a register and
# go back to work, we ask a question and they see it whenever they next sign
# in. Without these three, the loop only closes when the taxpayer happens to
# look — which for a return with a 15 April deadline is the difference between
# a filed rendition and a 10% penalty under Tax Code 22.28.
#
# Left unset, the app records what it would have sent in `notifications` and
# logs it, which is the local development mode. Nothing fails.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Tangible <reports@yourdomain.com>"
# The absolute URL the links in that mail point at. Vercel's own deployment URL
# is used when this is unset, so a preview links to itself — which is right for
# a preview and wrong for production, where it produces a *.vercel.app link
# rather than the domain the client was told to expect. Set it in production.
# The `links` health check reports which source won.
# NEXT_PUBLIC_APP_URL=https://app.yourdomain.com

# Resend will not send from a domain it has not verified. Add the domain at
# resend.com/domains, publish the DKIM and SPF records it prints, and wait for
# it to go green *before* setting MAIL_FROM to an address at that domain — an
# unverified sender is rejected at the API, which the app records as a failed
# `notifications` row and nobody reads until a client asks where their report
# went. The bare `onboarding@resend.dev` sender works without any of this and
# only delivers to the account owner, which is enough to test the plumbing and
# not enough to mail a client.

# ---------------------------------------------------------------------------
# Supabase Auth (deployment only — dashboard settings, not variables)
# ---------------------------------------------------------------------------
# Signing in is a mailed link, so it depends on three things in the Supabase
# dashboard that no environment variable here can set. Each of them fails the
# same silent way: the mail goes out, the link comes back to the wrong place,
# and the person is looking at a login page wondering what they did wrong.
#
#   Authentication -> URL Configuration -> Site URL
#       The same value as NEXT_PUBLIC_APP_URL. This is where a link goes when
#       nothing else says otherwise, and it is the fallback Supabase silently
#       substitutes whenever a requested redirect is not on the list below.
#
#   Authentication -> URL Configuration -> Redirect URLs
#       Must include the callback, and the wildcard if previews are used:
#           https://app.yourdomain.com/auth/callback
#           https://*-yourteam.vercel.app/auth/callback
#       A redirect that is not on this list is not refused — it is replaced by
#       the Site URL, which is why a link that "works in production and not on
#       preview" is almost always this.
#
#   Authentication -> Emails -> SMTP Settings
#       Supabase's built-in mailer is rate-limited to a couple of messages an
#       hour and is meant for development. Point it at the same Resend key as
#       above before any client uses this, or the second person to ask for a
#       sign-in link that hour does not get one. The password field on the
#       login page exists so this cannot lock the firm out of its own
#       workspace, but a client has no password to fall back on.
#
# One template is worth changing, under Authentication -> Emails -> Invite:
#
#       {{ .SiteURL }}/auth/callback?token_hash={{ .TokenHash }}&type=invite
#
# The default there sends the browser through Supabase's own /verify endpoint,
# which hands the session back in a URL fragment — and a fragment never reaches
# the server, so the route that establishes the session cannot see it. The form
# above passes the token as a query parameter, which it can. Left at the
# default the invitation dead-ends on the login page, and the recipient can
# still get in by asking for a sign-in link there.

# ---------------------------------------------------------------------------
# The analysis runner (deployment only)
# ---------------------------------------------------------------------------
# An analysis normally starts inside the request that queued it and finishes
# after the response. `/api/runs/drain` is what picks up the ones that did not:
# an invocation torn down mid-run, a deploy landing between the queue and the
# claim. vercel.json calls it every ten minutes; this is what authenticates it.
# Unset, the endpoint refuses rather than running open — an endpoint that
# starts analyses for anyone who finds it is a way to make this app do
# unbounded work for free. Vercel Cron sends this header automatically once the
# variable is set on the project.
#
# The same secret gates `/api/health/probe`, the sweep that records whether
# every dependency answered. Both refuse when it is unset, which means an
# unconfigured deployment silently never requeues an abandoned analysis and
# never writes down a single health check.
# CRON_SECRET=a-long-random-string

# ---------------------------------------------------------------------------
# Uptime monitoring (deployment only — not a variable)
# ---------------------------------------------------------------------------
# Point something *outside* this deployment at:
#
#     GET https://<your-app>/api/health
#
# every minute or two, and alert on a non-200. UptimeRobot, Better Stack,
# Checkly, or Vercel's own monitor all do this; which one does not matter, the
# vantage point does. The probe cron above runs inside the app, so it cannot
# see the app being down: a deployment that is not answering at all records
# nothing, and the operations screen goes quiet rather than red. Quiet is what
# an outage looks like from the inside, which is exactly why the check that
# matters has to come from the outside.
#
# The endpoint is past the auth gate on purpose — a monitor cannot sign in, and
# a health check that needs a session only ever proves that sessions work. It
# answers 503 when a dependency has failed, and anonymously it says only which
# dependencies exist and whether each replied. Send
# `Authorization: Bearer $CRON_SECRET` for the detail behind that.

# The connection the client portal uses, and only the client portal.
#
# DATABASE_URL connects as the owner, which carries BYPASSRLS — so every
# row-level policy in packages/db/sql/tenancy.sql is invisible to it, which is
# correct: the firm's own screens read across clients by design. This second
# role does not bypass RLS, and it is what a signed-in client's request runs on,
# inside a transaction that names which client is asking.
#
# Generated together with the role by packages/db/scripts/apply-tenancy.mjs,
# which prints the line to paste here. Unset in production, the portal answers
# 503 rather than falling back to the connection that would see everything.
# Unset in local development, nothing changes: an unconfigured sign-in resolves
# to the firm.
# CLIENT_DATABASE_URL=postgresql://tangible_client:...@host:5432/postgres
